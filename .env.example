# ─────────────────────────────────────────────────────────────
# You&Me environment configuration
# Copy to .env and fill in. Integrations marked OPTIONAL are
# disabled (and hidden or clearly labelled in the UI) when unset.
# ─────────────────────────────────────────────────────────────

# Core (REQUIRED)
DATABASE_URL=postgres://youandme:youandme@localhost:5432/youandme
BETTER_AUTH_SECRET=replace-with-32+-random-chars   # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth providers (OPTIONAL — button is hidden unless both values are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# AI concierge (OPTIONAL — without a key You&Me AI runs in "basic mode":
# real database results, rule-based intent parsing, templated explanations)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# Payments — Stripe Connect (REQUIRED in production for paid bookings)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Development only: set to "dev" to complete bookings without Stripe.
# Refused when NODE_ENV=production. UI shows a "test mode — no charge" banner.
PAYMENTS_PROVIDER=stripe

# Email — Resend (OPTIONAL in dev: emails are logged to the server console)
RESEND_API_KEY=
EMAIL_FROM="You&Me <hello@youandme.app>"

# Storage — S3-compatible (OPTIONAL in dev: files saved to ./uploads)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Realtime (OPTIONAL — messaging falls back to short polling)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# Analytics sink (OPTIONAL — events always go to the analytics_events table)
POSTHOG_KEY=
POSTHOG_HOST=

# Bootstrap: comma-separated emails granted super_admin on first sign-in
ADMIN_EMAILS=
